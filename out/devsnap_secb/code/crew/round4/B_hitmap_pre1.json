 "phrases": [
  {
   "line": 12,
   "text": "血未冷 刀不放",
   "start": 59.48,
   "end": 62.52
  },
  {
   "line": 13,
   "text": "谁人来定正邪一方",
   "start": 62.52,
   "end": 66.28
  },
  {
   "line": 14,
   "text": "若规则是铁壁铜墙",
   "start": 66.28,
   "end": 69.76
  },
  {
   "line": 15,
   "text": "那就劈开它看个天亮",
   "start": 69.76,
   "end": 74.1
  },
  {
   "line": 16,
   "text": "血未冷 骨未凉",
   "start": 74.1,
   "end": 77.2
  },
  {
   "line": 17,
   "text": "是非对错我自己扛",
   "start": 77.2,
   "end": 80.88
  },
  {
   "line": 18,
